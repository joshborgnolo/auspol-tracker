.DS_Store
node_modules/

# machine-local Claude Code settings (contains absolute paths)
.claude/settings.local.json

# scheduled-job logs
.build/logs/

# updater-slot lock dirs (self-releasing; stale dirs are reaped by pid check)
.build/locks/

# .matilda/ is agent scratch space shared by concurrent sessions — nothing
# under it belongs in a data/site commit except the curated skills.
.matilda/*
!.matilda/skills/

# Poll Bludger fallback: the cached feed is 600KB and refetched each run;
# seen.json (the first-seen grace ledger) beside it IS committed.
.build/pollbludger-src/current.xml

# layout healer: fetched evidence text and the agent's output scratch are
# per-run bulk; the .*-proof.json files beside them ARE committed on the
# review branch.
.build/healer-src/evidence/
.build/healer-out/

# vic-polish loop: per-round agent transcripts and audit packs are per-run
# bulk; polish-ledger.json beside them IS committed (the loop's memory).
.build/vic-src/polish-reports/

# wrangler's local build/state dir, left beside the dispatch-clock Worker by
# `npx wrangler deploy` (see .build/dispatch-clock/README.md)
.wrangler/

# /vic/ build: the converted dataset and gen-data outputs (regenerated every build)
.build/vic/out/

# Babel reprint cache for the site build (content-addressed; safe to delete)
.build/newtracker/.transpile-cache/
