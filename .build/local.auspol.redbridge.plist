<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <key>Label</key>
        <string>local.auspol.redbridge</string>
        <key>ProgramArguments</key>
        <array>
                <string>/bin/bash</string>
                <string>/Users/joshuaborgnolo/Library/Application Support/auspol-agents/redbridge.sh</string>
        </array>
        <key>EnvironmentVariables</key>
        <dict>
                <key>PATH</key>
                <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/local/bin</string>
        </dict>
        <key>StartCalendarInterval</key>
        <array>
                <!-- AFR/RedBridge/Accent file a federal poll roughly monthly:
                     fieldwork Mon-Thu in the last week, release Sun on or
                     just after the first weekend of the next month (2026:
                     May wave rel Sun 3 May, Jun wave rel Sun 31 May,
                     Jul wave rel Sun 2 Aug, plus a late-Nov/Dec pair).
                     Weekly Sunday sweep, then a daily sweep across the
                     month-end release window (28th-4th). The extractor
                     caches parsed PDF text under .build/redbridge-src, so
                     routine runs only re-check the newest waves (the
                     re-peer-from-page bit costs a headless-Chrome round
                     per uncached wave, which is why we don't run daily
                     all month). -->
                <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>28</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>29</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>30</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>31</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>2</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>3</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>4</integer><key>Hour</key><integer>6</integer></dict>
                <!-- Sunday evening, after AFR's 18:00 release (20:00 some
                     months): these slots exist for extract-redbridge-afr.mjs,
                     which files the wave from the AFR article's chart through
                     the logged-in Chrome only this laptop has. Already-read
                     articles are skipped (afr-seen.json), so a quiet Sunday
                     costs a sitemap fetch and nothing else. -->
                <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>20</integer></dict>
                <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
                <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>20</integer></dict>
                <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
                <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        </array>
        <key>StandardOutPath</key>
        <string>/Users/joshuaborgnolo/auspol tracker/.build/logs/launchd-redbridge-stdout.log</string>
        <key>StandardErrorPath</key>
        <string>/Users/joshuaborgnolo/auspol tracker/.build/logs/launchd-redbridge-stderr.log</string>
</dict>
</plist>
