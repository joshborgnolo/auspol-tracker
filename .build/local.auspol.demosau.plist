<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <key>Label</key>
        <string>local.auspol.demosau</string>
        <key>ProgramArguments</key>
        <array>
                <string>/bin/bash</string>
                <string>/Users/joshuaborgnolo/Documents/4. auspol/.build/demosau-updater.sh</string>
        </array>
        <key>EnvironmentVariables</key>
        <dict>
                <key>PATH</key>
                <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        </dict>
        <key>StartCalendarInterval</key>
        <array>
                <!-- DemosAU files a federal poll with Capital Brief roughly monthly
                     (2026 releases: Jan 13-21, Apr 9-14, May 15-20, Jun 16-18,
                     Jul 3-8, Aug 18-20) and federal MRPs occasionally; PDFs appear
                     on the methodology-statements index when released. Weekly
                     Tuesday sweep, then a daily sweep across the month-end window.
                     A cached source means routine runs fetch only the index page. -->
                <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>26</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>27</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>28</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>29</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>30</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>6</integer></dict>
                <dict><key>Day</key><integer>2</integer><key>Hour</key><integer>6</integer></dict>
        </array>
        <key>StandardOutPath</key>
        <string>/Users/joshuaborgnolo/Documents/4. auspol/.build/logs/launchd-demosau-stdout.log</string>
        <key>StandardErrorPath</key>
        <string>/Users/joshuaborgnolo/Documents/4. auspol/.build/logs/launchd-demosau-stderr.log</string>
</dict>
</plist>
