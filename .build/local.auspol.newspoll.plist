<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.auspol.newspoll</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/joshuaborgnolo/Library/Application Support/auspol-agents/newspoll.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/local/bin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<array>
		<!-- Newspoll publishes roughly every 3 weeks on Sunday evening AEST
		     (canonical rows show published ~20:00 Sun); sweep after release
		     time, again late evening, then next-morning and further catch-ups -->
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>19</integer></dict>
		<!-- release night: Newspoll files ~20:00, sometimes 21:00 (Sep 2026).
		     +5 and +10 minutes after each, then every 10 minutes to 21:30
		     (2026-10-05: a quiet run is ~12s and opens no Chrome tab — the
		     topic page reads through the cookie-keeping fetch and stories of
		     committed waves are skipped — so the comb costs nothing) -->
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>5</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>20</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>40</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>50</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>20</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>45</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer></dict>
		<dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer></dict>
		<dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer></dict>
	</array>
	<key>StandardOutPath</key>
	<string>/Users/joshuaborgnolo/auspol tracker/.build/logs/launchd-newspoll-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/joshuaborgnolo/auspol tracker/.build/logs/launchd-newspoll-stderr.log</string>
</dict>
</plist>
